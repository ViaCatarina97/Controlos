rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ISOLAMENTO POR LOJA
    // Cada documento `restaurants/{restaurantId}` guarda `memberUids` (contas com
    // acesso) e `ownerUid` (conta que criou a loja). Só essas contas conseguem ler
    // ou escrever a loja e todas as suas subcoleções. O acesso anónimo deixou de
    // existir: sem sessão válida, nada é acessível.
    //
    // NOTA DE DEPLOY (Firebase Console):
    // 1. Authentication → Sign-in method → ativar **Email/Password**.
    // 2. Authentication → Users → criar uma conta por loja (o utilizador da
    //    unidade convertido em email `<utilizador>@controlos.app`).
    // 3. Firestore → `restaurants/{id}` das lojas antigas → adicionar os campos
    //    `memberUids: ["<uid da conta>"]` e `ownerUid: "<uid da conta>"`.
    // Sem o passo 3 as lojas existentes ficam inacessíveis (por desenho: só o
    // acesso à consola concede acesso a dados já existentes).

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isStoreMember(restaurantId) {
      return isSignedIn()
        && isValidId(restaurantId)
        && request.auth.uid in
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.memberUids;
    }

    match /restaurants/{restaurantId} {
      // Listar exige a query `where('memberUids', 'array-contains', uid)`.
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow get: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn()
        && isValidId(restaurantId)
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.ownerUid == request.auth.uid;

      // Quem já pertence pode atualizar definições, mas não se pode remover a si
      // próprio (evita ficar sem acesso à própria loja).
      allow update: if isStoreMember(restaurantId)
        && request.auth.uid in request.resource.data.memberUids;

      allow delete: if false;

      // --- MIGRAÇÃO (TEMPORÁRIO) ---
      // Lojas criadas antes do isolamento não têm `memberUids`. A ausência do
      // campo é verificada com `in` (uma comparação `== null` falha em regras
      // quando o campo não existe). A escrita fica limitada a acrescentar
      // `memberUids`/`ownerUid` e a apagar a antiga `password` em texto simples:
      // nenhum outro campo e nenhuma subcoleção são afetados.
      // REMOVER este bloco quando todas as lojas antigas estiverem associadas.
      allow get: if isSignedIn() && !('memberUids' in resource.data);

      allow update: if isSignedIn()
        && !('memberUids' in resource.data)
        && !('password' in request.resource.data)
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'ownerUid', 'password']);

      match /{subcollection}/{docId} {
        allow read, write: if isStoreMember(restaurantId) && isValidId(docId);
      }
    }

    // Bloqueio global por defeito
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
