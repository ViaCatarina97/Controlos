rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTA DE DEPLOY:
    // Antes de publicar estas regras (`firebase deploy --only firestore:rules`),
    // confirme na Firebase Console -> Authentication -> Sign-in method que o método
    // "Anonymous" está ATIVADO (o código cliente em `services/firebaseService.ts`
    // já executa `ensureAuthenticated()` automaticamente no arranque).

    // Bloqueio global por defeito
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Coleção principal de unidades & subcoleções operacionais/financeiras
    match /restaurants/{restaurantId} {
      allow list: if isSignedIn();
      allow get, create, update: if isSignedIn() && isValidId(restaurantId);

      match /{subcollection}/{docId} {
        allow list: if isSignedIn() && isValidId(restaurantId);
        allow get, create, update, delete: if isSignedIn() && isValidId(restaurantId) && isValidId(docId);
      }
    }
  }
}
